# Copy to .env.local and fill in values:
#   cp .env.example .env.local

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# MongoDB connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net

# Optional database name (defaults to the DB in the connection string)
MONGODB_DB=menubattle

# -----------------------------------------------------------------------------
# AI battle setup (optional — falls back to demo options if unset)
# -----------------------------------------------------------------------------

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://apx-phi.vercel.app
OPENROUTER_APP_NAME=MenuBattle

# -----------------------------------------------------------------------------
# App URL (used for QR codes and payment redirects in production)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=https://apx-phi.vercel.app

# -----------------------------------------------------------------------------
# Mollie payments (Phase 3 — optional; demo checkout works without these)
# -----------------------------------------------------------------------------

MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=
